{
  "name": "node-banana",
  "version": "1.1.2",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:gate-a": "vitest run src/app/api/studio/workspaces/__tests__/route.test.ts src/app/api/studio/projects/__tests__/route.test.ts src/app/api/studio/projects/[projectId]/__tests__/route.test.ts src/app/api/studio/assets/__tests__/route.test.ts src/app/api/studio/assets/[assetId]/__tests__/route.test.ts src/app/api/studio/assets/presign/__tests__/route.test.ts src/components/__tests__/Header.test.tsx",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backfill:org": "node scripts/db-backfill-workspace-organizations.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:set-password": "node scripts/db-set-password.mjs",
    "db:set-workspace-quota": "node scripts/set-workspace-quota.mjs",
    "smoke:infra": "bash scripts/smoke-infra.sh",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.13",
    "@ai-sdk/react": "^3.0.51",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@google/genai": "^1.30.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@xyflow/react": "^12.9.3",
    "ai": "^6.0.49",
    "autoprefixer": "^10.4.22",
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.45.1",
    "jszip": "^3.10.1",
    "konva": "^10.0.12",
    "mediabunny": "^1.31.0",
    "next": "^16.0.7",
    "pg": "^8.20.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-compare-slider": "^3.1.0",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.17",
    "three": "^0.182.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.16",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^27.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.16"
  }
}
