{
  "name": "node-banana",
  "version": "1.1.2",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "node server.js",
    "node-banana": "tsx scripts/node-banana-cli.ts",
    "mcp": "tsx scripts/node-banana-mcp.ts",
    "proxy": "microfrontends proxy --local-apps node-banana",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:gate-a": "vitest run src/app/api/studio/workspaces/__tests__/route.test.ts src/app/api/studio/projects/__tests__/route.test.ts src/app/api/studio/projects/[projectId]/__tests__/route.test.ts src/app/api/studio/assets/__tests__/route.test.ts src/app/api/studio/assets/[assetId]/__tests__/route.test.ts src/app/api/studio/assets/presign/__tests__/route.test.ts src/app/api/social/accounts/__tests__/route.test.ts src/app/api/social/posts/__tests__/route.test.ts src/components/__tests__/Header.test.tsx",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backfill:org": "node scripts/db-backfill-workspace-organizations.mjs",
    "db:backfill:social": "node scripts/db-backfill-social-parity.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:set-password": "node scripts/db-set-password.mjs",
    "db:set-workspace-quota": "node scripts/set-workspace-quota.mjs",
    "smoke:infra": "bash scripts/smoke-infra.sh",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.13",
    "@ai-sdk/openai": "^3.0.49",
    "@ai-sdk/react": "^3.0.51",
    "@atproto/api": "^0.20.5",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/microfrontends": "^2.3.1",
    "@xyflow/react": "^12.9.3",
    "ai": "^6.0.64",
    "autoprefixer": "^10.4.22",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
