    "konva": "^10.0.12",
    "lucide-react": "^1.7.0",
    "mediabunny": "^1.31.0",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.11",
    "next": "^16.0.7",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-compare-slider": "^3.1.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.1",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
