# ------------------------------------------------------------------------------
# AI provider inference keys — DEV / TEST ONLY. The product is BYOK.
# ------------------------------------------------------------------------------
# The running product does NOT read these on any inference path. Generation and
# LLM routes resolve keys per request as: request header (X-<Provider>-API-Key)
# → the workspace's encrypted provider-key vault (Settings → Provider Keys) →
# a typed "no key configured" error. The business never bills the operator's own
# key for customer inference.
#
# These variables remain only for local scripts, tests, and smoke tooling that
# call providers directly outside the request pipeline. Leave them unset for a
# normal BYOK product run.

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# fal.ai — https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here

# Kie.ai — https://kie.ai/
KIE_API_KEY=your_kie_api_key_here

# WaveSpeed — https://wavespeed.ai/
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# ------------------------------------------------------------------------------
# Infrastructure (Postgres + Better Auth)
# ------------------------------------------------------------------------------

# Postgres connection string (Docker local default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_banana

# Public marketing and product origins. Attach both production domains to the
# same Vercel project; the host-aware request proxy keeps marketing on the apex/`www`
# origin and product UI on the `app` origin. Bare localhost intentionally uses
# one origin for both surfaces.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Public base URL of the app. Used to build OAuth redirect URIs when the
# request "origin" header is unavailable (e.g. behind a reverse proxy).
# Must exactly match the redirect URI registered with OAuth providers —
# required for the Mastodon connect flow in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=change_this_to_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra trusted origins (useful for local IP/127.0.0.1 dev URLs)
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Merchant of Record — Paddle Billing
# ------------------------------------------------------------------------------
# Keep sandbox selected until catalog, checkout, transaction.completed webhook,
# recovery, and portal flows all pass. Sandbox never moves real money and uses a
# separate Paddle account, API key, client token, and notification secret.
MERCHANT_OF_RECORD_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
# Server-only Paddle API key (`pdl_sdbx_...` in sandbox, `pdl_live_...` live).
PADDLE_API_KEY=
# Public Paddle.js token (`test_...` in sandbox, `live_...` live). Never put the
# server API key in this variable.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Secret for the exact Paddle notification destination that POSTs raw bytes to
# /api/studio/webhooks/merchant. Subscribe to transaction.completed,
# transaction.canceled, adjustment.created/updated, and subscription.created/
# activated/updated/past_due/paused/resumed/canceled; other correctly signed
# events are acknowledged.
PADDLE_WEBHOOK_SECRET=
# Approved HTTPS default payment-link page. For local testing use an HTTPS tunnel
# to /checkout/paddle and configure that same URL in Paddle sandbox Checkout settings.
PADDLE_CHECKOUT_URL=
# Exact comma-separated HTTPS redirect hosts for checkout and customer portal.
# Include the PADDLE_CHECKOUT_URL host and the portal host observed in sandbox.
PADDLE_ALLOWED_REDIRECT_HOSTS=
# Exact comma-separated HTTPS hosts returned by Paddle's transaction invoice
# endpoint. Determine these from sandbox before production; never use a wildcard.
PADDLE_ALLOWED_INVOICE_HOSTS=
# Signature age tolerance in seconds; Paddle SDKs default to 5. Maximum accepted
# here is 300 and increasing it weakens replay resistance.
PADDLE_WEBHOOK_TOLERANCE_SECONDS=5
# Paid execution remains available for this many days after Paddle reports a
# subscription past due. The accepted range is 1–30 days; default 7.
MERCHANT_SUBSCRIPTION_GRACE_DAYS=7

# ------------------------------------------------------------------------------
# Referral cash payout gateway
# ------------------------------------------------------------------------------
# A server-controlled adapter that holds provider-specific payout credentials
# and exposes the narrow contract in docs/operations/referral-payouts.md. The
# product sends only an opaque verified recipient reference and immutable payout
# identity; bank, routing, IBAN, tax-document, and legal-name data never enter
# Node Banana. Production requires HTTPS. HTTP is accepted only on loopback.
REFERRAL_PAYOUT_GATEWAY_URL=
REFERRAL_PAYOUT_GATEWAY_TOKEN=
REFERRAL_PAYOUT_PROVIDER_NAME=
# Bounded to 1-30 seconds. A submit timeout becomes outcome_unknown and is
# reconciled by stable provider idempotency key; it is never blindly retried.
REFERRAL_PAYOUT_GATEWAY_TIMEOUT_MS=15000

# Scoped non-human Better Auth membership projection service. The receiver must
# verify the HMAC, persist projectionId/requestDigest receipts, and replay the
# first outcome. Human cookies and broad owner identities are never accepted.
GOVERNANCE_MEMBERSHIP_PROJECTION_URL=
GOVERNANCE_MEMBERSHIP_PROJECTION_KEY_ID=
GOVERNANCE_MEMBERSHIP_PROJECTION_SIGNING_KEY=

# Authenticates Studio maintenance routes, including governance recovery. Vercel
# Cron may instead use Authorization: Bearer $CRON_SECRET.
STUDIO_INTERNAL_API_SECRET=

# Required in production for verified email/password signup.
AUTH_EMAIL_DELIVERY=console
RESEND_API_KEY=
AUTH_FROM_EMAIL=Tasmeem AI <auth@example.com>
# Local-only: include verification links in console email output.
AUTH_ALLOW_CONSOLE_EMAIL_LINKS=false

# Arabic-first onboarding rollout. Internal IDs are always included unless the
# kill switch is active. Percentage assignment is deterministic per user ID.
ONBOARDING_ROLLOUT_PERCENT=100
ONBOARDING_INTERNAL_USER_IDS=
ONBOARDING_KILL_SWITCH=false
# Exact immutable Replicate model ref for onboarding's admitted text lane.
# JSON shape: {"provider":"replicate","model":"...","version":"...","inputSchemaDigest":"sha256:..."}
ONBOARDING_REPLICATE_MODEL_REF_JSON=

# Legacy single-version Agent pepper. Used as version 1 only when
# AGENT_KEY_PEPPERS is unset. When migrating, place the same value in the
# keyring's version 1 entry before selecting a newer active version.
AGENT_KEY_PEPPER=
# Versioned Agent pepper keyring for deployable rotation. Format:
# AGENT_KEY_PEPPERS=1=<base64url-secret>,2=<base64url-secret>
# Values must be at least 32 base64url characters. Retain old versions while
# any Agent keys, pairing challenges, or provisioning receipts use them.
AGENT_KEY_PEPPERS=
# Positive integer selecting an entry from AGENT_KEY_PEPPERS for new secrets.
AGENT_KEY_PEPPER_ACTIVE_VERSION=
# Active key ID and retained AES-256-GCM keyring for BYOK envelopes.
# Example shape: {"vault-2026":{"version":1,"key":"<64 hex>"}}
CREDENTIAL_VAULT_ACTIVE_KEY_ID=
CREDENTIAL_VAULT_KEYRING=
# Active first, retained AES-256-GCM keyring for authenticated Runtime Run
# event cursors. Format: kid:<base64url-32-byte-key>,previous:<key>.
WORKFLOW_RUN_CURSOR_KEYS=
# Active first, retained AES-256-GCM keyring for authenticated Observability
# cursors. Format: kid:<base64url-32-byte-key>,previous:<key>.
OBSERVABILITY_CURSOR_KEYS=
# Active first, retained AES-256-GCM keyring for authenticated Publishing Plan
# revision cursors. Use a domain-specific keyring; do not reuse another cursor
# key. Format: kid:<base64url-32-byte-key>,previous:<key>.
PUBLISHING_PLAN_CURSOR_KEYS=
# Active first, retained AES-256-GCM keyring for requester-scoped Publishing
# Approval cursors. Use a separate domain keyring. Format:
# kid:<base64url-32-byte-key>,previous:<key>.
PUBLISHING_APPROVAL_CURSOR_KEYS=

# Publishing Delivery inspect/list cursor encryption keys (key-id:base64url-32-bytes).
PUBLISHING_DELIVERY_CURSOR_KEYS=
# Maximum due Delivery outbox intents relayed by one internal scheduler request.
PUBLISHING_DELIVERY_RELAY_BATCH_SIZE=20
# Random bearer secret (at least 16 characters) attached automatically by
# Vercel to scheduled production requests.
CRON_SECRET=
# Shared secret for the internal Runtime Run outbox relay. Vercel Cron may use
# CRON_SECRET instead when this value is unset.
AGENT_RUNTIME_INTERNAL_SECRET=
WORKFLOW_RUN_RELAY_BATCH_SIZE=20
# Optional: cloudflare, vercel, fly, or generic. Only the selected
# deployment proxy's client-IP headers are trusted for pairing rate limits.
PAIRING_TRUSTED_PROXY=

# Optional local-only bypass for AI Studio authz hardening.
# Never enable this in production.
DEV_AUTH_BYPASS=false
DEV_USER_ID=local-user
DEV_WORKSPACE_ID=local-workspace

# ------------------------------------------------------------------------------
# Asset Storage
# ------------------------------------------------------------------------------

# Storage backend: "local" (current behavior) or "s3"
STORAGE_BACKEND=local

# S3-compatible object storage (required only when STORAGE_BACKEND=s3)
# "s3" means S3 API compatible (AWS S3, Cloudflare R2, MinIO, etc.)
# Cloudflare R2 recommended defaults: S3_REGION=auto, S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET_NAME=your_bucket_name
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Agent Artifact staging must have an object-storage lifecycle rule that
# expires the exact prefix agent-artifacts/staging/ within at most 24 hours.
# Set this to the configured maximum age in whole hours (1-24).
S3_ARTIFACT_STAGING_LIFECYCLE_MAX_HOURS=24

# Contracted licensed-trend providers may push ordered, signed catalog events
# to /api/studio/webhooks/licensed-trends/<provider-key>. This is a JSON map of
# provider key -> key ID -> Ed25519 SPKI PEM. Retain an old public key until all
# events signed by it have reached a terminal inbox state. Example shape:
# {"licensed.partner":{"partner-2026":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}}
# Omitting this variable disables the public provider-ingestion boundary. It is
# not an AI key and configuring it never performs or pays for generation.
LICENSED_TREND_PROVIDER_PUBLIC_KEYS_JSON=

# ------------------------------------------------------------------------------
# Social Hub — Token Encryption
# ------------------------------------------------------------------------------

# AES-256-GCM encryption key for social account OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# Required in production. In dev with DEV_AUTH_BYPASS=true, tokens are stored in plaintext.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Shared secret for protected internal social maintenance endpoints
# (e.g., /api/social/internal/cleanup). Generate with: openssl rand -hex 32
#
# IMPORTANT when deploying on Vercel: Vercel Cron Jobs authenticate by sending
# `Authorization: Bearer $CRON_SECRET` (a Vercel-managed env var you set in
# Project Settings > Environment Variables). The internal routes already
# accept that same `Authorization: Bearer <secret>` header shape, so set this
# variable to the EXACT SAME VALUE as CRON_SECRET and cron-triggered requests
# will authenticate with no extra code. See docs/social-cron-scheduler.md.
SOCIAL_INTERNAL_API_SECRET=

# ------------------------------------------------------------------------------
# BYOK Provider Key Vault
# ------------------------------------------------------------------------------

# AES-256-GCM encryption key for per-workspace AI provider keys (Gemini, OpenAI,
# Anthropic, Kie, Fal, Replicate, WaveSpeed) at rest. Separate from
# SOCIAL_TOKEN_ENCRYPTION_KEY so rotating one never invalidates the other.
# Generate with: openssl rand -hex 32
# Required in production. In dev with DEV_AUTH_BYPASS=true, keys are stored in plaintext.
BYOK_KEY_ENCRYPTION_KEY=

# Platform-funded Replicate lane. Keep this credential separate from customer
# BYOK and qualification tokens. Rotation changes the revision and invalidates
# any asynchronous work pinned to the previous credential.
REPLICATE_MANAGED_API_TOKEN=
REPLICATE_MANAGED_KEY_REVISION=
# Fixed operator-reviewed conversion rate used to quote Generation Credits.
# Example only: 0.01 means one credit covers USD 0.01 of provider execution.
MANAGED_GENERATION_USD_PER_CREDIT=

# Local canonical media storage (Docker Compose MinIO). Admitted image/video
# generation is fail-closed unless an S3-compatible store is configured because
# provider output must be copied into Workspace-owned storage before success.
# Start it with `pnpm infra:up`, then use this local profile:
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=node-banana
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=node-banana-local
# S3_SECRET_ACCESS_KEY=node-banana-local-secret
# S3_FORCE_PATH_STYLE=true

# Admitted generation. Catalog discovery remains non-executable until an
# operator supplies reviewed immutable Replicate version/schema contracts,
# exact locked safety/mode/resolution/audio parameters, exact 9:16 output
# dimensions/fps, authoritative USD formula, max units, license, pricing source,
# and qualification-run evidence in a signed versioned envelope. JSON alone
# never authorizes execution. Never use approximate discovery prices here.
REPLICATE_MODEL_QUALIFICATIONS_JSON=
# Signed immutable training qualification envelopes for Creator Personas.
# These independently pin provider policy, source contract, language/Arabic
# coverage, verified regions, exact per-run quote, and qualification-run proof.
PERSONA_TRAINING_QUALIFICATIONS_JSON=
# JSON map of signing key ID to Ed25519 SPKI PEM. Only attestations signed by a
# configured trust root can make a catalog lane executable.
MODEL_QUALIFICATION_PUBLIC_KEYS_JSON=
# Operator-only qualification CLI. Supply ephemerally and invoke only as
# `pnpm qualify:replicate reviewed-plan.json --execute-paid-smoke`; never
# configure this private key in a runtime deployment. Omitting the exact flag
# exits before constructing the network adapter, so the default is no calls.
MODEL_QUALIFICATION_SIGNING_PRIVATE_KEY=
# Dedicated least-privileged Replicate token used only by the explicit paid
# qualification command. Do not reuse a customer BYOK credential.
REPLICATE_QUALIFICATION_API_TOKEN=
# Optional API root override. Production should retain the pinned HTTPS default.
REPLICATE_QUALIFICATION_API_BASE_URL=https://api.replicate.com/v1/
# Trusted internal qualification harness. The app now provides the verified,
# append-only webhook receiver and bearer-protected observer below. Point the
# public URL at an HTTPS tunnel and the observer URL at this app's local origin:
#   QUALIFICATION_WEBHOOK_URL=https://<tunnel>/api/studio/webhooks/replicate-qualification
#   QUALIFICATION_WEBHOOK_OBSERVER_URL=http://localhost:3002/api/studio/internal/qualification-webhooks
# Output ingestion and externally evidenced provider-account billing remain
# separate trusted services. Never use the ordinary product webhook URL here.
QUALIFICATION_HARNESS_TOKEN=
QUALIFICATION_WEBHOOK_URL=
QUALIFICATION_WEBHOOK_OBSERVER_URL=
# Local implementation: http://localhost:3002/api/studio/internal/qualification-artifacts
QUALIFICATION_INGESTION_URL=
# Local implementation: http://localhost:3002/api/studio/internal/qualification-spend
QUALIFICATION_SPEND_OBSERVER_URL=
# JSON map of spend-observer key ID to Ed25519 SPKI PEM. This trust root is
# independent from MODEL_QUALIFICATION_PUBLIC_KEYS_JSON.
QUALIFICATION_SPEND_RECEIPT_PUBLIC_KEYS_JSON=
# Server-only signing authority for reviewed-price authorizations and imported
# Replicate account evidence. The private key must match the public key at this
# key ID above. Generate a distinct Ed25519 pair; never reuse the model-attestation key.
QUALIFICATION_SPEND_SIGNING_KEY_ID=
QUALIFICATION_SPEND_SIGNING_PRIVATE_KEY=
# Must exactly match the independently reviewed processing route
# `processing/provider:replicate` in the active Workspace Data Region Policy.
# Never infer it from APP_DATA_REGION, S3_REGION, or a deployment/model name.
PROVIDER_REGION_REPLICATE=
# Allowlisted HTTPS delivery hosts used only after a prediction/output receipt
# has been durably claimed. Comma-separated; subdomains are accepted.
REPLICATE_OUTPUT_HOSTS=replicate.delivery
# Standard Webhooks signing secret used by the public Replicate completion
# receiver. Completion notifications only wake durable credential-bound polling.
REPLICATE_WEBHOOK_SIGNING_SECRET=
# Idempotent internal gateway used for Persona training submission/recovery.
# The token must be durable server-side; never forward browser or transient BYOK
# credentials to an asynchronous training effect.
REPLICATE_PERSONA_TRAINING_GATEWAY_URL=
REPLICATE_PERSONA_TRAINING_GATEWAY_TOKEN=
# HMAC secret (at least 32 bytes) for Workspace/filter-bound Operations cursors.
OPERATION_CURSOR_SECRET=
# Release-quality controls. Both are required for trustworthy production status
# and unlinkable product telemetry pseudonyms. The status Workspace is the only
# Workspace whose incident summaries may appear on the public status pages.
TELEMETRY_PSEUDONYM_SECRET=
PUBLIC_STATUS_WORKSPACE_ID=
RELEASE_ATTESTATION_KEYS_JSON=
RELEASE_AUTOMATION_USER_ID=
RELEASE_ATTESTATION_INGEST_SECRET=
RELEASE_MANIFEST_JSON=
RELEASE_MANIFEST_SIGNATURE=
RELEASE_MANIFEST_SECRET=
RELEASE_DEPLOYMENT_GATE_SECRET=
RELEASE_READINESS_SIGNING_KEY_ID=
RELEASE_READINESS_SIGNING_SECRET=
RELEASE_TELEMETRY_RETENTION_SECRET=

# Workspace governance signing keys. Generate independent 32-byte values and
# encode them as base64. Production review media and provider-spend bulk quotes
# fail closed when their corresponding key is absent or malformed.
GOVERNANCE_REVIEW_MEDIA_SIGNING_KEY=
GOVERNANCE_BULK_QUOTE_SIGNING_KEY=
# Independent 32-byte base64 keys for one-time secret delivery and encrypted,
# signed Workspace exports. Import trust keys and region trust keys are JSON
# objects mapping key IDs to base64 keys.
GOVERNANCE_SECRET_DELIVERY_KEY=
GOVERNANCE_EXPORT_ENCRYPTION_KEY=
GOVERNANCE_EXPORT_SIGNING_KEY=
GOVERNANCE_IMPORT_TRUST_KEYS={}
# JSON map of key ID to an independent base64-encoded HMAC key (32+ bytes).
# Generate and sign route evidence with `pnpm governance:region-evidence`;
# see docs/operations/provider-region-evidence.md.
GOVERNANCE_REGION_TRUST_KEYS={}
APP_DATA_REGION=
GOVERNANCE_EXPORT_STORAGE_REGION=
GOVERNANCE_IMPORT_STORAGE_REGION=
GOVERNANCE_IMPORT_PROCESSING_REGION=
GOVERNANCE_DELETION_REGION=
# Required production adapters for backup/log deletion, evidence-store deletion,
# and current-policy Safety Appeal revalidation. Absence remains fail-closed.
GOVERNANCE_DELETION_SYSTEMS=primary
GOVERNANCE_DELETION_ADAPTER_URL=
GOVERNANCE_DELETION_ADAPTER_SECRET=
GOVERNANCE_PRIMARY_EVIDENCE_DELETION_URL=
GOVERNANCE_PRIMARY_EVIDENCE_DELETION_SECRET=
GOVERNANCE_SAFETY_REVALIDATION_URL=
GOVERNANCE_SAFETY_REVALIDATION_SECRET=
# Required before a Workspace can complete closure. This least-privileged
# integration performs provider disconnect/revoke and retention-aware hard
# erasure, returning one terminal evidence receipt per exact effect.
GOVERNANCE_CLOSURE_EFFECT_URL=
GOVERNANCE_CLOSURE_EFFECT_SECRET=

# ------------------------------------------------------------------------------
# Social Hub — Scheduler & Cron
# ------------------------------------------------------------------------------
# The dispatch pipeline (src/app/api/social/internal/*) only runs when a
# scheduler invokes it. See docs/social-cron-scheduler.md for the full wiring.

# Optional internal scheduler tuning (defaults shown; all are safe to omit)
SOCIAL_DISPATCH_BATCH_SIZE=20
SOCIAL_DISPATCH_MAX_ATTEMPTS=5
SOCIAL_STUCK_PUBLISHING_MINUTES=30
SOCIAL_STUCK_SWEEP_BATCH_SIZE=50
SOCIAL_STUCK_MAX_RECOVERY_ATTEMPTS=3
SOCIAL_TOKEN_REFRESH_BATCH_SIZE=25
SOCIAL_TOKEN_REFRESH_BUFFER_MINUTES=15
SOCIAL_WEBHOOK_DELIVERY_BATCH_SIZE=25
SOCIAL_WEBHOOK_DELIVERY_MAX_ATTEMPTS=6
SOCIAL_RECONCILE_BATCH_SIZE=25
SOCIAL_RECONCILE_MIN_AGE_SECONDS=60
SOCIAL_AUTOMATION_DISPATCH_BATCH_SIZE=20

# Vercel-managed cron authentication secret (NOT read directly by app code).
# Set this in Vercel Project Settings > Environment Variables to the SAME
# VALUE as SOCIAL_INTERNAL_API_SECRET above. Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` on every cron-triggered request; see
# vercel.json's `crons` array and docs/social-cron-scheduler.md.
# Not needed for local dev or non-Vercel deployments (use QStash instead, see docs).
CRON_SECRET=

# ------------------------------------------------------------------------------
# Social Hub — Platform Credentials
# ------------------------------------------------------------------------------
# Each platform requires a developer app. Only configure the platforms you plan to use.

# X (Twitter) — OAuth 1.0a
# Create app at: https://developer.x.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=

# X Ads Conversion API — first-party acquisition attribution only.
# These credentials are intentionally separate from customer social publishing.
# The feature fails closed until the operator switch, all credentials, event IDs,
# public privacy notice, and the two human review versions are present.
X_ADS_ATTRIBUTION_ENABLED=false
X_ADS_API_VERSION=12
X_ADS_PIXEL_ID=
X_ADS_API_KEY=
X_ADS_API_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
X_ADS_EVENT_ID_SIGN_UP=
X_ADS_EVENT_ID_TRIAL_STARTED=
X_ADS_EVENT_ID_PURCHASE=
X_ADS_ACCOUNT_CURRENCY=
X_ADS_PRIVACY_NOTICE_VERSION=
X_ADS_REGION_REVIEW_VERSION=
X_ADS_API_ACCESS_REVIEW_VERSION=
X_ADS_EVENT_RETENTION_DAYS=30
X_ADS_RECEIPT_RETENTION_DAYS=365

# LinkedIn — OAuth 2.0
# Create app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Instagram + Facebook) — shared OAuth app
# Create app at: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=

# TikTok — OAuth 2.0
# Create app at: https://developers.tiktok.com/apps/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube — Google OAuth 2.0 (may share with Better Auth Google OAuth)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public, metadata-only YouTube most-popular discovery. This is intentionally
# separate from account OAuth and from billable generation. The lane remains
# fail-closed until the API key, operator switch, and Node Banana's own public
# Terms/Privacy disclosures are all configured.
YOUTUBE_TREND_DISCOVERY_ENABLED=false
YOUTUBE_DATA_API_KEY=
# Fail-closed compliance gate. Set true only after written approval covers the
# exact durable Brand/Blitz content-adaptation use and retention model.
YOUTUBE_CONTENT_ADAPTATION_APPROVED=false
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Reddit — OAuth 2.0
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nodebanana/1.0

# Pinterest — OAuth 2.0
# Create app at: https://developers.pinterest.com/
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Bluesky — App Password auth (no developer app or env vars required).
# Users supply their handle + an App Password generated at
# https://bsky.app/settings/app-passwords when connecting a channel.

# Mastodon — dynamic per-instance OAuth (no developer app or env vars required).
# An OAuth app is registered automatically on each instance the first time a
# user connects, and the credentials are stored in social_mastodon_instances.
# Requires NEXT_PUBLIC_APP_URL to be set correctly in production (see above).
