# ------------------------------------------------------------------------------
# AI provider inference keys — DEV / TEST ONLY. The product is BYOK.
# ------------------------------------------------------------------------------
# The running product does NOT read these on any inference path. Generation and
# LLM routes resolve keys per request as: request header (X-<Provider>-API-Key)
# → the workspace's encrypted provider-key vault (Settings → Provider Keys) →
# a typed "no key configured" error. The business never bills the operator's own
# key for customer inference.
#
# These variables remain only for local scripts, tests, and smoke tooling that
# call providers directly outside the request pipeline. Leave them unset for a
# normal BYOK product run.

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# fal.ai — https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here

# Kie.ai — https://kie.ai/
KIE_API_KEY=your_kie_api_key_here

# WaveSpeed — https://wavespeed.ai/
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# ------------------------------------------------------------------------------
# Infrastructure (Postgres + Better Auth)
# ------------------------------------------------------------------------------

# Postgres connection string (Docker local default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_banana

# Public marketing and product origins. Attach both production domains to the
# same Vercel project; the host-aware request proxy keeps marketing on the apex/`www`
# origin and product UI on the `app` origin. Bare localhost intentionally uses
# one origin for both surfaces.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Public base URL of the app. Used to build OAuth redirect URIs when the
# request "origin" header is unavailable (e.g. behind a reverse proxy).
# Must exactly match the redirect URI registered with OAuth providers —
# required for the Mastodon connect flow in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=change_this_to_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra trusted origins (useful for local IP/127.0.0.1 dev URLs)
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# Governance membership projection service identity. The configured Better Auth
# user must hold exactly the `admin` organization role (never `owner`) in every
# projected organization. Store the complete current Better Auth Cookie header
# value as a deployment secret and rotate it before session expiry. Missing,
# invalid, or over-privileged credentials fail closed into an observable
# membership_projection dead-letter rather than silently mutating access.
GOVERNANCE_MEMBERSHIP_PROJECTION_USER_ID=
GOVERNANCE_MEMBERSHIP_PROJECTION_COOKIE=

# Authenticates Studio maintenance routes, including governance recovery. Vercel
# Cron may instead use Authorization: Bearer $CRON_SECRET.
STUDIO_INTERNAL_API_SECRET=

# Required in production for verified email/password signup.
AUTH_EMAIL_DELIVERY=console
RESEND_API_KEY=
AUTH_FROM_EMAIL=Tasmeem AI <auth@example.com>
# Local-only: include verification links in console email output.
AUTH_ALLOW_CONSOLE_EMAIL_LINKS=false

# Arabic-first onboarding rollout. Internal IDs are always included unless the
# kill switch is active. Percentage assignment is deterministic per user ID.
ONBOARDING_ROLLOUT_PERCENT=100
ONBOARDING_INTERNAL_USER_IDS=
ONBOARDING_KILL_SWITCH=false
ONBOARDING_LLM_MODEL=gemini-2.5-flash

# Legacy single-version Agent pepper. Used as version 1 only when
# AGENT_KEY_PEPPERS is unset. When migrating, place the same value in the
# keyring's version 1 entry before selecting a newer active version.
AGENT_KEY_PEPPER=
# Versioned Agent pepper keyring for deployable rotation. Format:
# AGENT_KEY_PEPPERS=1=<base64url-secret>,2=<base64url-secret>
# Values must be at least 32 base64url characters. Retain old versions while
# any Agent keys, pairing challenges, or provisioning receipts use them.
AGENT_KEY_PEPPERS=
# Positive integer selecting an entry from AGENT_KEY_PEPPERS for new secrets.
AGENT_KEY_PEPPER_ACTIVE_VERSION=
# Active key ID and retained AES-256-GCM keyring for BYOK envelopes.
# Example shape: {"vault-2026":{"version":1,"key":"<64 hex>"}}
CREDENTIAL_VAULT_ACTIVE_KEY_ID=
CREDENTIAL_VAULT_KEYRING=
# Active first, retained AES-256-GCM keyring for authenticated Runtime Run
# event cursors. Format: kid:<base64url-32-byte-key>,previous:<key>.
WORKFLOW_RUN_CURSOR_KEYS=
# Active first, retained AES-256-GCM keyring for authenticated Observability
# cursors. Format: kid:<base64url-32-byte-key>,previous:<key>.
OBSERVABILITY_CURSOR_KEYS=
# Active first, retained AES-256-GCM keyring for authenticated Publishing Plan
# revision cursors. Use a domain-specific keyring; do not reuse another cursor
# key. Format: kid:<base64url-32-byte-key>,previous:<key>.
PUBLISHING_PLAN_CURSOR_KEYS=
# Active first, retained AES-256-GCM keyring for requester-scoped Publishing
# Approval cursors. Use a separate domain keyring. Format:
# kid:<base64url-32-byte-key>,previous:<key>.
PUBLISHING_APPROVAL_CURSOR_KEYS=

# Publishing Delivery inspect/list cursor encryption keys (key-id:base64url-32-bytes).
PUBLISHING_DELIVERY_CURSOR_KEYS=
# Maximum due Delivery outbox intents relayed by one internal scheduler request.
PUBLISHING_DELIVERY_RELAY_BATCH_SIZE=20
# Random bearer secret (at least 16 characters) attached automatically by
# Vercel to scheduled production requests.
CRON_SECRET=
# Shared secret for the internal Runtime Run outbox relay. Vercel Cron may use
# CRON_SECRET instead when this value is unset.
AGENT_RUNTIME_INTERNAL_SECRET=
WORKFLOW_RUN_RELAY_BATCH_SIZE=20
# Optional: cloudflare, vercel, fly, or generic. Only the selected
# deployment proxy's client-IP headers are trusted for pairing rate limits.
PAIRING_TRUSTED_PROXY=

# Optional local-only bypass for AI Studio authz hardening.
# Never enable this in production.
DEV_AUTH_BYPASS=false
DEV_USER_ID=local-user
DEV_WORKSPACE_ID=local-workspace

# ------------------------------------------------------------------------------
# Asset Storage
# ------------------------------------------------------------------------------

# Storage backend: "local" (current behavior) or "s3"
STORAGE_BACKEND=local

# S3-compatible object storage (required only when STORAGE_BACKEND=s3)
# "s3" means S3 API compatible (AWS S3, Cloudflare R2, MinIO, etc.)
# Cloudflare R2 recommended defaults: S3_REGION=auto, S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET_NAME=your_bucket_name
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Agent Artifact staging must have an object-storage lifecycle rule that
# expires the exact prefix agent-artifacts/staging/ within at most 24 hours.
# Set this to the configured maximum age in whole hours (1-24).
S3_ARTIFACT_STAGING_LIFECYCLE_MAX_HOURS=24

# ------------------------------------------------------------------------------
# Social Hub — Token Encryption
# ------------------------------------------------------------------------------

# AES-256-GCM encryption key for social account OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# Required in production. In dev with DEV_AUTH_BYPASS=true, tokens are stored in plaintext.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Shared secret for protected internal social maintenance endpoints
# (e.g., /api/social/internal/cleanup). Generate with: openssl rand -hex 32
#
# IMPORTANT when deploying on Vercel: Vercel Cron Jobs authenticate by sending
# `Authorization: Bearer $CRON_SECRET` (a Vercel-managed env var you set in
# Project Settings > Environment Variables). The internal routes already
# accept that same `Authorization: Bearer <secret>` header shape, so set this
# variable to the EXACT SAME VALUE as CRON_SECRET and cron-triggered requests
# will authenticate with no extra code. See docs/social-cron-scheduler.md.
SOCIAL_INTERNAL_API_SECRET=

# ------------------------------------------------------------------------------
# BYOK Provider Key Vault
# ------------------------------------------------------------------------------

# AES-256-GCM encryption key for per-workspace AI provider keys (Gemini, OpenAI,
# Anthropic, Kie, Fal, Replicate, WaveSpeed) at rest. Separate from
# SOCIAL_TOKEN_ENCRYPTION_KEY so rotating one never invalidates the other.
# Generate with: openssl rand -hex 32
# Required in production. In dev with DEV_AUTH_BYPASS=true, keys are stored in plaintext.
BYOK_KEY_ENCRYPTION_KEY=

# Release-quality controls. Both are required for trustworthy production status
# and unlinkable product telemetry pseudonyms. The status Workspace is the only
# Workspace whose incident summaries may appear on the public status pages.
TELEMETRY_PSEUDONYM_SECRET=
PUBLIC_STATUS_WORKSPACE_ID=

# ------------------------------------------------------------------------------
# Social Hub — Scheduler & Cron
# ------------------------------------------------------------------------------
# The dispatch pipeline (src/app/api/social/internal/*) only runs when a
# scheduler invokes it. See docs/social-cron-scheduler.md for the full wiring.

# Optional internal scheduler tuning (defaults shown; all are safe to omit)
SOCIAL_DISPATCH_BATCH_SIZE=20
SOCIAL_DISPATCH_MAX_ATTEMPTS=5
SOCIAL_STUCK_PUBLISHING_MINUTES=30
SOCIAL_STUCK_SWEEP_BATCH_SIZE=50
SOCIAL_STUCK_MAX_RECOVERY_ATTEMPTS=3
SOCIAL_TOKEN_REFRESH_BATCH_SIZE=25
SOCIAL_TOKEN_REFRESH_BUFFER_MINUTES=15
SOCIAL_WEBHOOK_DELIVERY_BATCH_SIZE=25
SOCIAL_WEBHOOK_DELIVERY_MAX_ATTEMPTS=6
SOCIAL_RECONCILE_BATCH_SIZE=25
SOCIAL_RECONCILE_MIN_AGE_SECONDS=60
SOCIAL_AUTOMATION_DISPATCH_BATCH_SIZE=20

# Vercel-managed cron authentication secret (NOT read directly by app code).
# Set this in Vercel Project Settings > Environment Variables to the SAME
# VALUE as SOCIAL_INTERNAL_API_SECRET above. Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` on every cron-triggered request; see
# vercel.json's `crons` array and docs/social-cron-scheduler.md.
# Not needed for local dev or non-Vercel deployments (use QStash instead, see docs).
CRON_SECRET=

# ------------------------------------------------------------------------------
# Social Hub — Platform Credentials
# ------------------------------------------------------------------------------
# Each platform requires a developer app. Only configure the platforms you plan to use.

# X (Twitter) — OAuth 1.0a
# Create app at: https://developer.x.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=

# LinkedIn — OAuth 2.0
# Create app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Instagram + Facebook) — shared OAuth app
# Create app at: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=

# TikTok — OAuth 2.0
# Create app at: https://developers.tiktok.com/apps/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube — Google OAuth 2.0 (may share with Better Auth Google OAuth)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reddit — OAuth 2.0
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nodebanana/1.0

# Pinterest — OAuth 2.0
# Create app at: https://developers.pinterest.com/
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Bluesky — App Password auth (no developer app or env vars required).
# Users supply their handle + an App Password generated at
# https://bsky.app/settings/app-passwords when connecting a channel.

# Mastodon — dynamic per-instance OAuth (no developer app or env vars required).
# An OAuth app is registered automatically on each instance the first time a
# user connects, and the credentials are stored in social_mastodon_instances.
# Requires NEXT_PUBLIC_APP_URL to be set correctly in production (see above).
